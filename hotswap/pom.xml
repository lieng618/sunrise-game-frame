<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.sunrise.game</groupId>
        <artifactId>sunrise-game-frame</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>hotswap</artifactId>
    <version>${project.sunrise.version}</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- 热更模块不需要任何外部依赖，只依赖JDK自带的instrument API -->
    <dependencies>
        <!-- 无任何依赖，保持Agent Jar最小化 -->
    </dependencies>

    <build>
        <plugins>
            <!-- 热更内核仍作为普通依赖进入共享库；Agent 包只包含最小引导类 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>

            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>make-hotswap-agent</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <finalName>hotswap-agent</finalName>
                            <outputDirectory>${project.basedir}/../start/jar</outputDirectory>
                            <appendAssemblyId>false</appendAssemblyId>
                            <!-- Agent 是独立发布件，不能替换 hotswap 主依赖 JAR。 -->
                            <attach>false</attach>
                            <archive>
                                <manifestEntries>
                                    <Premain-Class>org.sunrise.game.core.AgentBootstrap</Premain-Class>
                                    <Can-Redefine-Classes>true</Can-Redefine-Classes>
                                    <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                    <Implementation-Title>Hotswap Agent</Implementation-Title>
                                    <Implementation-Version>${project.version}</Implementation-Version>
                                </manifestEntries>
                            </archive>
                            <descriptors>
                                <descriptor>src/main/assembly/agent.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
