<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.sunrise.game</groupId>
        <artifactId>sunrise-game-frame</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>game</artifactId>
    <version>${project.sunrise.version}</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.sunrise.game</groupId>
            <artifactId>network</artifactId>
            <version>${project.sunrise.version}</version>
        </dependency>
        <dependency>
            <groupId>org.sunrise.game</groupId>
            <artifactId>gen</artifactId>
            <version>${project.sunrise.version}</version>
        </dependency>
        <dependency>
            <groupId>org.sunrise.game</groupId>
            <artifactId>hotswap</artifactId>
            <version>${project.sunrise.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.34</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <compilerArgs>
                        <arg>-proc:full</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- 所有 JAR 打包统一用一个 assembly-plugin，7 个 execution -->
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <executions>

                    <!-- ======== 共享库：所有依赖（不含 game 自身代码） ======== -->
                    <execution>
                        <id>make-shared-lib</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <finalName>sunrise-lib</finalName>
                            <outputDirectory>${project.basedir}/../start/jar</outputDirectory>
                            <appendAssemblyId>false</appendAssemblyId>
                            <archive>
                                <manifest>
                                    <addClasspath>false</addClasspath>
                                </manifest>
                            </archive>
                            <descriptors>
                                <descriptor>src/main/assembly/shared-lib.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>

                    <!-- ======== ExternalServer（thin） ======== -->
                    <execution>
                        <id>make-assembly-external</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <finalName>sunrise-external</finalName>
                            <outputDirectory>${project.basedir}/../start/jar</outputDirectory>
                            <appendAssemblyId>false</appendAssemblyId>
                            <archive>
                                <manifest>
                                    <mainClass>org.sunrise.game.external.main.ExternalServerStartUp</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Class-Path>sunrise-lib.jar</Class-Path>
                                </manifestEntries>
                            </archive>
                            <descriptors>
                                <descriptor>src/main/assembly/thin-jar.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>

                    <!-- ======== GameServer（thin） ======== -->
                    <execution>
                        <id>make-assembly-game</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <finalName>sunrise-game</finalName>
                            <outputDirectory>${project.basedir}/../start/jar</outputDirectory>
                            <appendAssemblyId>false</appendAssemblyId>
                            <archive>
                                <manifest>
                                    <mainClass>org.sunrise.game.game.main.GameServerStartUp</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Class-Path>sunrise-lib.jar</Class-Path>
                                </manifestEntries>
                            </archive>
                            <descriptors>
                                <descriptor>src/main/assembly/thin-jar.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>

                    <!-- ======== GlobalServer（thin） ======== -->
                    <execution>
                        <id>make-assembly-global</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <finalName>sunrise-global</finalName>
                            <outputDirectory>${project.basedir}/../start/jar</outputDirectory>
                            <appendAssemblyId>false</appendAssemblyId>
                            <archive>
                                <manifest>
                                    <mainClass>org.sunrise.game.global.main.GlobalServerStartUp</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Class-Path>sunrise-lib.jar</Class-Path>
                                </manifestEntries>
                            </archive>
                            <descriptors>
                                <descriptor>src/main/assembly/thin-jar.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>

                    <!-- ======== GmBackServer（thin） ======== -->
                    <execution>
                        <id>make-assembly-gmback</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <finalName>sunrise-gmback</finalName>
                            <outputDirectory>${project.basedir}/../start/jar</outputDirectory>
                            <appendAssemblyId>false</appendAssemblyId>
                            <archive>
                                <manifest>
                                    <mainClass>org.sunrise.game.gmback.main.GmBackServerStartUp</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Class-Path>sunrise-lib.jar</Class-Path>
                                </manifestEntries>
                            </archive>
                            <descriptors>
                                <descriptor>src/main/assembly/thin-jar.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>

                    <!-- ======== HttpServer（thin） ======== -->
                    <execution>
                        <id>make-assembly-http</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <finalName>sunrise-http</finalName>
                            <outputDirectory>${project.basedir}/../start/jar</outputDirectory>
                            <appendAssemblyId>false</appendAssemblyId>
                            <archive>
                                <manifest>
                                    <mainClass>org.sunrise.game.http.main.HttpServerStartUp</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Class-Path>sunrise-lib.jar</Class-Path>
                                </manifestEntries>
                            </archive>
                            <descriptors>
                                <descriptor>src/main/assembly/thin-jar.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>

                    <!-- ======== RunAllOneServer（thin） ======== -->
                    <execution>
                        <id>make-assembly-runallone</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <finalName>sunrise-runallone</finalName>
                            <outputDirectory>${project.basedir}/../start/jar</outputDirectory>
                            <appendAssemblyId>false</appendAssemblyId>
                            <archive>
                                <manifest>
                                    <mainClass>org.sunrise.game.runone.main.RunAllOneServerStartUp</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Class-Path>sunrise-lib.jar</Class-Path>
                                </manifestEntries>
                            </archive>
                            <descriptors>
                                <descriptor>src/main/assembly/thin-jar.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>

                </executions>
            </plugin>
        </plugins>
    </build>
</project>