# Copy to .env and adjust for your environment.
# Shared secrets (injected into all services via docker-compose)
JDBC_URL=jdbc:mysql://mysql:3306/sunrise
JDBC_USER=root
JDBC_PASSWORD=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
PLAYER_JWT_SECRET=change-me-to-a-random-32-char-string

# Address game clients use to reach the external gateway (host IP or domain).
# Use 127.0.0.1 only when the client runs on the Docker host itself.
EXTERNAL_ADDRESS=127.0.0.1

# Per-service overrides are set in docker-compose.yml (REPORT_ADDRESS, MASTER_ADDRESS, etc.)
